# EcoSonic 2.0 Backend Configuration
PROJECT_NAME="EcoSonic 2.0 Bioacoustic Intelligence"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
DATABASE_URL="sqlite+aiosqlite:///./storage/ecosonic.db"

# Storage Settings
STORAGE_BASE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=268435456 # 256 MB

# Audio Ingestion & Processing Settings
DEFAULT_SAMPLE_RATE=32000
TARGET_CHANNELS=1
ALLOWED_AUDIO_EXTENSIONS=["wav", "mp3", "flac", "ogg", "m4a"]

# Model Integration Settings
MODEL_VERSION="BirdNET+ V3.0"
BIRDNET_CONFIDENCE_THRESHOLD=0.25
NUM_WORKER_THREADS=4
