{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "ecosonic-main": {
      "root": "ECOsonic-main",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/ecosonic-main",
      "destination": {
        "service": "ecosonic-main",
        "path": "/"
      }
    },
    {
      "source": "/ecosonic-main/:path*",
      "destination": {
        "service": "ecosonic-main",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
